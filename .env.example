# Telegram bot token from @BotFather (required)
BOT_TOKEN=your_bot_token_here

# Redis for game state and FSM (docker compose overrides this with the redis service)
REDIS_URL=redis://localhost:6379/0

# Optional: PostgreSQL for game statistics. Leave empty to run without stats.
DATABASE_URL=postgresql://user:password@localhost:5432/mafia_bot
